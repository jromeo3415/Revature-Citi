```gitignore
# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.so

# Python build / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
pip-wheel-metadata/
MANIFEST

# Type checking / linting / coverage caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover


# ============================================================
# Virtual environments
# ============================================================

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/


# ============================================================
# Environment / Secrets
# ============================================================

.env
.env.*
!.env.example

# Don't commit local secret/config files
*.pem
*.key
*.crt
secrets/
secrets.json

# Local AWS / deployment credentials
lambda-env.json


# ============================================================
# Node / Vite / Frontend
# ============================================================

node_modules/

# Vite build output
dist/
dist-ssr/
.vite/

# Local Vite environment files
*.local

# npm
npm-debug.log*
npm-error.log*

# Yarn
yarn-debug.log*
yarn-error.log*
yarn-error.log*

# pnpm
pnpm-debug.log*

# Other package managers
lerna-debug.log*


# ============================================================
# AWS Lambda
# ============================================================

# Generated Lambda dependency directory
package/

# Generated deployment archive
lambda.zip

# SAM build artifacts
.aws-sam/

# Serverless Framework
.serverless/

# Terraform state (if Terraform is ever added)
.terraform/
*.tfstate
*.tfstate.*


# ============================================================
# Databases / Local Development
# ============================================================

# SQLite databases
*.db
*.sqlite
*.sqlite3

# SQLAlchemy / Alembic local artifacts
*.sqlitedb

# Local database dumps
*.dump
*.bak


# ============================================================
# Logs
# ============================================================

logs/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ============================================================
# IDE / Editors
# ============================================================

.vscode/*
!.vscode/extensions.json

.idea/
*.iml

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Vim
*.swp
*.swo
*~

# JetBrains
*.iws


# ============================================================
# OS
# ============================================================

.DS_Store
.DS_Store?
.AppleDouble
.LSOverride

Thumbs.db
ehthumbs.db
Desktop.ini


# ============================================================
# Temporary / Misc
# ============================================================

*.tmp
*.temp
*.bak
*.swp

# Python tooling
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/
```
